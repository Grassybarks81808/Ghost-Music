{
  "name": "ghost-music",
  "private": true,
  "description": "Your music. Your other side. A full-stack music app with Windows, Android, and web builds.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grassybarks81808/Ghost-Music.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/generate-art.mjs && node scripts/generate-audio.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dist:desktop": "node scripts/build-desktop.mjs && npm --prefix desktop run dist",
    "build:android": "bash scripts/build-android.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/inter": "^5.3.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "pg": "8.20.0",
    "playwright": "^1.64.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "source-map-js": "^1.2.2",
    "youtube-dl-exec": "^3.1.17"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.17": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
