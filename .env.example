# Copy to `.env` for a server deployment. Every value is optional:
# with no DATABASE_URL the app runs on its embedded PGlite library, which is how
# the packaged Windows and Android builds work.

# PostgreSQL connection string. Omit to use the embedded database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Where downloads and the embedded library are written. Defaults to the current
# working directory for a server, and to the user's app-data folder when the
# desktop app launches the server itself.
# GHOST_DATA_DIR=/var/lib/ghost-music

# Hostname and port for `next start`. The desktop app picks its own free port.
# PORT=3000
# HOSTNAME=0.0.0.0
